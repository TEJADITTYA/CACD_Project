APP_ENV=development
PORT=5000
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=scamdetect

# Optional OpenAI-compatible chat endpoint. Without these, the transparent
# local heuristic detector is used.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Twilio SMS delivery. Create an account at https://www.twilio.com/.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000

# SMTP email delivery (optional).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

URL_REPUTATION_API_KEY=